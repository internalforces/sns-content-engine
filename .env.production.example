# Copy this file to /opt/sns-content-engine/.env and keep real secrets private.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////opt/sns-content-engine/data/sns_content_engine.db
DEFAULT_TIMEZONE=Asia/Seoul

# Draft provider settings for the checked-in OpenAI-first country-news path.
# Keep unused provider vars blank or unset; blank values are ignored safely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=30

# Publisher credential bundles referenced from config/accounts.yaml.
# For the first one-account country-news verification, reuse the existing X bundle.
X_AI_TOOLS_DAILY_PUBLISHER_CREDENTIALS=
X_JAPAN_GLOBAL_NEWS_PUBLISHER_CREDENTIALS=
# THREADS_KOREA_GLOBAL_NEWS_PUBLISHER_CREDENTIALS='{"access_token":"replace-with-threads-user-access-token","threads_user_id":"replace-with-threads-user-id"}'
# THREADS_JAPAN_GLOBAL_NEWS_PUBLISHER_CREDENTIALS='{"access_token":"replace-with-threads-user-access-token","threads_user_id":"replace-with-threads-user-id"}'
